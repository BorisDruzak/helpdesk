            "discriminator": {
              "mapping": {
                "and": "#/$defs/AllAny",
                "eq": "#/$defs/Comparison",
                "exists": "#/$defs/Exists",
                "gt": "#/$defs/Comparison",
                "gte": "#/$defs/Comparison",
                "in": "#/$defs/Membership",
                "lt": "#/$defs/Comparison",
                "lte": "#/$defs/Comparison",
                "neq": "#/$defs/Comparison",
                "not": "#/$defs/Negation",
                "or": "#/$defs/AllAny"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Comparison"
              },
              {
                "$ref": "#/$defs/Membership"
              },
              {
                "$ref": "#/$defs/Exists"
              },
              {
                "$ref": "#/$defs/AllAny"
              },
              {
                "$ref": "#/$defs/Negation"
              }
            ]
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "op",
        "conditions"
      ],
      "title": "AllAny",
      "type": "object"
    },
