APP_ENV=prod
# Optional Sentry backend observability. Set the real DSN only in the protected
# /etc/helpdesk/helpdesk.env (root-owned, mode 0600); empty/unset disables the SDK.
SENTRY_DSN=
# Public browser client key, injected into dynamic HTML; empty disables capture.
SENTRY_BROWSER_DSN=
SENTRY_BROWSER_TRACES_SAMPLE_RATE=0.05
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.10
# Optional exact deployed 40-character Git SHA override; normally omit this and
# use release-identity.json in the immutable release. No client key belongs here.
SENTRY_RELEASE=
ALLOW_INSECURE_DEV_DEFAULTS=false
AUTH_ALLOW_QUERY_TOKEN=false
AUTH_UI_CONFIG_FALLBACK_ENABLED=false
ENABLE_DB_PERSISTENCE=true
DATABASE_URL=postgresql+asyncpg://helpdesk:CHANGE_ME@127.0.0.1:5432/helpdesk
PC_CLIENT_SERVER_DATA_ROOT=/var/lib/helpdesk
PC_CLIENT_DISABLE_LEGACY_RUNTIME_MIGRATION=true
SERVER_HOST=127.0.0.1
SERVER_PORT=8666
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8667
HELPDESK_CONTROL_LIFECYCLE_ENABLED=false
SERVER_PUBLIC_BASE_URL=https://helpdesk.sosnadmin.local
REQUIRE_HTTPS=true
REQUIRE_WSS=true
WEB_SESSION_COOKIE_SECURE=true
TRUST_X_FORWARDED_FOR=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32
ENDPOINT_PORT_MODE=unavailable
ENDPOINT_DIAGNOSTIC_EXECUTION_MODE=endpoint
TECH_BACKUP_STATUS_PATH=/var/lib/helpdesk/backup-status.json
TECH_RESTORE_DRILL_STATUS_PATH=/var/lib/helpdesk/restore-drill-status.json
TECH_RELEASE_STATUS_PATH=/var/lib/helpdesk/release-status.json
TECH_BUSINESS_SMOKE_STATUS_PATH=/var/lib/helpdesk/business-smoke-status.json
REQUIRE_BACKUP_RESTORE_EVIDENCE=true
