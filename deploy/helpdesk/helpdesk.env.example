APP_ENV=dev
ENABLE_DB_PERSISTENCE=true
DATABASE_URL=postgresql+asyncpg://helpdesk:CHANGE_ME@127.0.0.1:5432/helpdesk
PC_CLIENT_SERVER_DATA_ROOT=/var/lib/helpdesk
PC_CLIENT_DISABLE_LEGACY_RUNTIME_MIGRATION=true
SERVER_HOST=127.0.0.1
SERVER_PORT=8666
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8667
SERVER_PUBLIC_BASE_URL=http://192.168.100.19:8080
REQUIRE_HTTPS=false
REQUIRE_WSS=false
WEB_SESSION_COOKIE_SECURE=false
TRUST_X_FORWARDED_FOR=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32
ENDPOINT_PORT_MODE=unavailable
ENDPOINT_DIAGNOSTIC_EXECUTION_MODE=legacy
