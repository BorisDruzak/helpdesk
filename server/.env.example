# Копировать в .env и заполнить. Файл .env в .gitignore, в репозиторий не попадает.
# На удалённом хосте (Linux) server/.env обязателен для запуска сервера и миграций.

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/pc_client
APP_ENV=dev
ENABLE_DB_PERSISTENCE=true
ALLOW_INSECURE_DEV_DEFAULTS=false
PILOT_STAND_MODE=false
REQUIRE_HTTPS=false
REQUIRE_WSS=false
WEB_SESSION_COOKIE_SECURE=true
AUTH_ALLOW_QUERY_TOKEN=false
AUTH_UI_CONFIG_FALLBACK_ENABLED=false
INVENTORY_REFRESH_SCHEDULER_ENABLED=false
SERVER_PUBLIC_BASE_URL=http://127.0.0.1:8666
REQUIRE_BACKUP_RESTORE_EVIDENCE=false
PC_CLIENT_DB_POOL_SIZE=10
PC_CLIENT_DB_MAX_OVERFLOW=20
PC_CLIENT_DB_POOL_TIMEOUT_SEC=30
PC_CLIENT_DB_POOL_RECYCLE_SEC=1800
